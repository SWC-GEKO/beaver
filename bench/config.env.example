# ---- GCP ------------------------------------------------------------------
export PROJECT_ID="${PROJECT_ID:?set PROJECT_ID in config.env}"
export REGION="${REGION:-europe-west3}"
export ZONE="${ZONE:-europe-west3-b}"

# ---- Profile: "test" = cheap smoke/test runs, "final" = real measurements ----
export PROFILE="${PROFILE:-test}"

# ---- Names ------------------------------------------------------------------
export NETWORK="bench-vpc"
export SUBNET="bench-subnet"
export SUBNET_RANGE="10.10.0.0/20"
export RUNNER_SA_NAME="bench-runner"
export RUNNER_SA="${RUNNER_SA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"
export BUCKET="${PROJECT_ID}-bench"               # Dataflow staging/temp + result backups
export AR_REPO="bench"                            # Artifact Registry (docker) repo
export LG_VM="bench-lg"                           # load generator / orchestrator VM
export BEAVER_VM="bench-beaver"                   # runs Beaver (control plane, NATS, shards)
export VALKEY_NAME="bench-valkey"
export CR_SERVICE_SINGLE="bench-faas-single"
export CR_SERVICE_BATCH="bench-faas-batch"

# ---- Versions -----------------------------------------------------------------
export GO_VERSION="${GO_VERSION:-1.26.1}"         # must satisfy go.mod of the beaver repo
export BEAVER_REPO_URL="https://github.com/SWC-GEKO/beaver"

# ---- Machine sizes + matrix, by profile --------------------------------------------
case "$PROFILE" in
  test)
    export LG_MACHINE="${LG_MACHINE:-e2-standard-2}"
    export BEAVER_MACHINE="${BEAVER_MACHINE:-e2-standard-4}"
    export DF_MACHINE="${DF_MACHINE:-n1-standard-2}"
    export VALKEY_NODE="${VALKEY_NODE:-shared-core-nano}"
    export REPS_EXP12="${REPS_EXP12:-1}"
    export DURATIONS="${DURATIONS:-10}"
    export SYSTEMS="${SYSTEMS:-beaver dataflow faas-single faas-batch}"
    export REPS_EXP3="${REPS_EXP3:-1}"
    export SHARDS="${SHARDS:-1 2}"
    export CONCURRENCY="${CONCURRENCY:-2 64}"
    export WARMUP_SEC="${WARMUP_SEC:-10}"
    export MEASURE_SEC="${MEASURE_SEC:-20}"
    ;;
  final)
    export LG_MACHINE="${LG_MACHINE:-e2-standard-4}"
    export BEAVER_MACHINE="${BEAVER_MACHINE:-e2-standard-16}"
    export DF_MACHINE="${DF_MACHINE:-n1-standard-2}"
    export VALKEY_NODE="${VALKEY_NODE:-shared-core-nano}"
    export REPS_EXP12="${REPS_EXP12:-5}"          # use 5 if Dataflow cost/time hurts
    export DURATIONS="${DURATIONS:-10 30 60}"
    export SYSTEMS="${SYSTEMS:-beaver dataflow faas-single faas-batch}"
    export REPS_EXP3="${REPS_EXP3:-3}"
    export SHARDS="${SHARDS:-1 2 4 8}"
    export CONCURRENCY="${CONCURRENCY:-1 2 4 8 16 32 64 128 256 512 1024 2048 4096}"   # 2^0 .. 2^12 streams
    export WARMUP_SEC="${WARMUP_SEC:-20}"
    export MEASURE_SEC="${MEASURE_SEC:-60}"
    ;;
  *) echo "unknown PROFILE=$PROFILE (use test|final)" >&2; return 1 2>/dev/null || exit 1 ;;
esac

# ---- Experiments 1+2 (cold start + processing overhead) ------------------------
export RATE="${RATE:-10}"                  # events per second within a stream
export KEYS_EXP12="${KEYS_EXP12:-32}"      # distinct keys
export SEED="${SEED:-42}"
export BEAVER_REPLICATION_EXP12="${BEAVER_REPLICATION_EXP12:-4}"   # physical shards (containers)
export BEAVER_VSHARDS="${BEAVER_VSHARDS:-128}"                     # virtual shards (kept constant)

# ---- Experiment 3 (Beaver scalability) -----------------------------------------
export CR_PREDEPLOY_MAX="${CR_PREDEPLOY_MAX:-16}"   # max. predeployed Cloud Run revisions alive at once (regional CPU quota)
export STREAM_RATE="${STREAM_RATE:-10}"    # events/s per concurrent stream
export KEYSPACE_EXP3="${KEYSPACE_EXP3:-4096}"
export COOLDOWN_SEC="${COOLDOWN_SEC:-10}"
export DRAIN_SEC="${DRAIN_SEC:-20}"

# ---- Cloud Run (FaaS) ------------------------------------------------------------------
export CR_CPU="${CR_CPU:-1}"
export CR_MEMORY="${CR_MEMORY:-512Mi}"
export CR_CONCURRENCY="${CR_CONCURRENCY:-1}"   # 1 = classic FaaS semantics (Cloud Functions gen2 default)
export CR_MAX_INSTANCES_SINGLE="${CR_MAX_INSTANCES_SINGLE:-20}"   # FaaS-Single: one instance per in-flight request
export CR_MAX_INSTANCES_BATCH="${CR_MAX_INSTANCES_BATCH:-3}"      # FaaS-Batched: few instances, many events each
# public  = service allows unauthenticated calls (no token on the hot path; matches a plain public function)
# private = IAM-protected, the load generator sends an identity token
export CR_AUTH="${CR_AUTH:-public}"
# Waits (seconds after deploy) probed by `./bench.sh calibrate-cr`
export CALIBRATE_WAITS="${CALIBRATE_WAITS:-120 300 600 900}"
# Seconds to wait after deploying a revision so the instance started by the deploy
# health check is gone before the run. Verify with `cold_verified` in the results;
# raise it (max ~900) if runs are flagged warm.
export CR_IDLE_WAIT="${CR_IDLE_WAIT:-960}"

# ---- Dataflow --------------------------------------------------------------------------
export DF_ZONE="${DF_ZONE:-}"                      # empty = Dataflow chooses a zone with capacity in $REGION (a pinned zone can be out of stock)
export DF_ATTEMPTS="${DF_ATTEMPTS:-3}"             # submit again (fresh t0, topic, job) if the job itself failed
export DF_TIMEOUT_SEC="${DF_TIMEOUT_SEC:-1500}"    # max wait for results after submit

# ---- Beaver host -------------------------------------------------------------------------
export BEAVER_ROUTER_QUIET="${BEAVER_ROUTER_QUIET:-1}"  # strip per-message log lines from router image
export BEAVER_QUIET="${BEAVER_QUIET:-1}"                # strip the per-event log line from the control plane observer
# Container resources of a deployed function (applied to the generated compose project).
# The router is deliberately BIGGER than the processors so it is never the bottleneck.
# 0 = no limit.
export BEAVER_ROUTER_CPUS="${BEAVER_ROUTER_CPUS:-4}"
export BEAVER_ROUTER_MEM_MIB="${BEAVER_ROUTER_MEM_MIB:-2048}"
export BEAVER_PROCESSOR_CPUS="${BEAVER_PROCESSOR_CPUS:-1}"
export BEAVER_PROCESSOR_MEM_MIB="${BEAVER_PROCESSOR_MEM_MIB:-512}"
export BEAVER_DOCKER_PRIME_TIMEOUT="${BEAVER_DOCKER_PRIME_TIMEOUT:-180}"

# ---- Result handling -------------------------------------------------------------------------
export CAMPAIGN="${CAMPAIGN:-$PROFILE}"            # results/<CAMPAIGN>/...
export LOG_WAIT_SEC="${LOG_WAIT_SEC:-900}"         # max wait for Cloud Logging to deliver all lines
